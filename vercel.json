{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/login",
          "destination": "/index.html"
        },
        {
          "source": "/register",
          "destination": "/index.html"
        },
        {
          "source": "/verify-email",
          "destination": "/index.html"
        },
        {
          "source": "/transactions",
          "destination": "/index.html"
        },
        {
          "source": "/budgets",
          "destination": "/index.html"
        },
        {
          "source": "/profile",
          "destination": "/index.html"
        },
        {
          "source": "/admin",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/graphql",
      "destination": { "service": "backend" }
    },
    {
      "source": "/auth/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/health",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
